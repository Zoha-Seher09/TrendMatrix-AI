# ---------------------------------------------------------------------
# Application setup
# ---------------------------------------------------------------------

BASE_DIR = Path(__file__).resolve().parent
DATA_DIR = BASE_DIR / "data"
CHARTS_DIR = DATA_DIR / "charts"
REPORTS_DIR = DATA_DIR / "reports"

CHARTS_DIR.mkdir(parents=True, exist_ok=True)
REPORTS_DIR.mkdir(parents=True, exist_ok=True)

app = Flask(__name__)
app.config.from_object(Config)

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(message)s",
)

logger = logging.getLogger("trendmatrix")

init_db()

SUPPORTED_VARIABLES = {
    "temperature": "Air Temperature",
    "humidity": "Relative Humidity",
    "wind_speed": "Wind Speed",
    "precipitation": "Precipitation",
    "soil_moisture": "Soil Moisture",
    "evapotranspiration": "Evapotranspiration",
    "ndvi": "Normalized Difference Vegetation Index (NDVI)",
    "solar_radiation": "Solar Radiation",
}

# Photon is an OpenStreetMap-based global geocoding service.
PHOTON_URL = "https://photon.komoot.io/api/"

GEOCODING_USER_AGENT = (
    "TrendMatrixAI/1.0 "
    "(NASA Space Apps educational project)"
)

# Short-lived in-memory cache for repeated location searches.
GEOCODING_CACHE = {}
GEOCODING_CACHE_TTL = 300
GEOCODING_CACHE_LIMIT = 200

# Gemini should not hold the entire dashboard request indefinitely.
GEMINI_WAIT_SECONDS = 18


# ---------------------------------------------------------------------
# General helpers
# ---------------------------------------------------------------------

def to_dict(value: Any) -> dict:
    if value is None:
        return {}

    if isinstance(value, dict):
        return value

    if hasattr(value, "keys"):
        return {key: value[key] for key in value.keys()}

    return {}


def safe_filename(value: str) -> str:
    return (
        re.sub(r"[^a-zA-Z0-9_-]+", "_", str(value)).strip("_")
        or "output"
    )


def call_compatible(function, available_values: dict, aliases=None):
    """Pass only parameters supported by an existing project function."""

    signature = inspect.signature(function)
    aliases = aliases or {}

    kwargs = {}

    accepts_kwargs = any(
        parameter.kind == inspect.Parameter.VAR_KEYWORD
        for parameter in signature.parameters.values()
    )

    for name, parameter in signature.parameters.items():

        if parameter.kind in (
            inspect.Parameter.VAR_POSITIONAL,
            inspect.Parameter.VAR_KEYWORD,
        ):
            continue

        source_name = (
            name if name in available_values else aliases.get(name)
        )

        if source_name in available_values:
            kwargs[name] = available_values[source_name]

        elif parameter.default == inspect.Parameter.empty:
            raise RuntimeError(
                f"Missing required parameter '{name}' "
                f"for {function.__name__}."
            )

    if accepts_kwargs:
        for name, value in available_values.items():
            kwargs.setdefault(name, value)

    return function(**kwargs)


def json_safe(value: Any):
    """Convert Pandas and NumPy values into JSON-compatible values."""

    if isinstance(value, dict):
        return {
            str(key): json_safe(item)
            for key, item in value.items()
        }

    if isinstance(value, (list, tuple)):
        return [json_safe(item) for item in value]

    if isinstance(value, (pd.Timestamp, datetime, date)):
        return value.isoformat()

    if hasattr(value, "item"):
        try:
            value = value.item()
        except (ValueError, TypeError):
            pass

    if value is None:
        return None

    try:
        if pd.isna(value):
            return None
    except (ValueError, TypeError):
        pass

    return value


def filter_requested_dates(
    dataframe: pd.DataFrame,
    start_date: str,
    end_date: str,
) -> pd.DataFrame:
    """Keep observations within the requested date range."""

    result = dataframe.copy()

    index = pd.to_datetime(result.index, errors="coerce")
    valid = ~index.isna()

    result = result.loc[valid].copy()
    result.index = index[valid]

    start = pd.Timestamp(start_date)
    end = (
        pd.Timestamp(end_date)
        + pd.Timedelta(days=1)
        - pd.Timedelta(microseconds=1)
    )

    return result.loc[
        (result.index >= start) & (result.index <= end)
    ].sort_index()


def prepare_requested_frequency(
    dataframe: pd.DataFrame,
    variable_id: str,
    frequency: str,
    metadata: dict,
) -> tuple[pd.DataFrame, dict]:
    """
    Aggregate daily observations into monthly observations when requested.

    Precipitation is accumulated; other variables use monthly means.
    """

    result = dataframe.copy()
    updated_metadata = dict(metadata)

    if frequency == "monthly":

        result.index = pd.to_datetime(result.index, errors="coerce")
        result = result.loc[~result.index.isna()]

        if variable_id not in result.columns:
            raise ValueError(
                f"Variable '{variable_id}' is missing from the dataset."
            )

        if variable_id == "precipitation":
            result = result[[variable_id]].resample("MS").sum(
                min_count=1
            )

            updated_metadata["unit"] = "mm/month"

        else:
            result = result[[variable_id]].resample("MS").mean()

        result = result.dropna(subset=[variable_id])

    else:
        result = result.sort_index()

    if result.empty:
        raise ValueError(
            "No valid observations remain after frequency processing."
        )

    updated_metadata["frequency"] = frequency
    updated_metadata["observation_count"] = len(result)

    result.attrs.update(updated_metadata)

    return result, updated_metadata


# ---------------------------------------------------------------------
# Request validation
# ---------------------------------------------------------------------

def validate_request_data(payload: dict):

    variable_id = str(
        payload.get("variable", "")
    ).strip().lower()

    region_name = str(
        payload.get("region", "")
    ).strip()

    start_date = str(
        payload.get("start_date", "")
    ).strip()

    end_date = str(
        payload.get("end_date", "")
    ).strip()

    frequency = str(
        payload.get("frequency", "monthly")
    ).strip().lower()

    if variable_id not in SUPPORTED_VARIABLES:
        return {}, "Please select a supported Earth science variable."

    if not region_name:
        return {}, "Please select a location from the suggestions."

    if frequency not in {"daily", "monthly"}:
        return {}, "Frequency must be daily or monthly."

    try:
        start = date.fromisoformat(start_date)
        end = date.fromisoformat(end_date)

    except ValueError:
        return {}, "Please select valid start and end dates."

    if start >= end:
        return {}, "End date must be later than start date."

    try:
        latitude = float(payload.get("latitude"))
        longitude = float(payload.get("longitude"))

    except (TypeError, ValueError):
        return {}, "Please select a location from the suggestions."

    if not -90 <= latitude <= 90:
        return {}, "Invalid latitude."

    if not -180 <= longitude <= 180:
        return {}, "Invalid longitude."

    return {
        "variable_id": variable_id,
        "variable_name": SUPPORTED_VARIABLES[variable_id],
        "region_name": region_name,
        "latitude": latitude,
        "longitude": longitude,
        "start_date": start_date,
        "end_date": end_date,
        "frequency": frequency,
    }, None


# ---------------------------------------------------------------------
# Global location search
# ---------------------------------------------------------------------

def get_photon_display_name(properties: dict) -> tuple[str, str]:

    name = (
        properties.get("name")
        or properties.get("city")
        or properties.get("country")
        or "Unknown location"
    )

    locality = (
        properties.get("city")
        or properties.get("district")
        or properties.get("county")
        or properties.get("state")
        or ""
    )

    country = properties.get("country", "")

    context_parts = []

    for part in (locality, properties.get("state"), country):

        if part and part.casefold() != str(name).casefold():
            if part not in context_parts:
                context_parts.append(part)

    context = ", ".join(context_parts)

    short_name = name

    if context:
        short_name = f"{name}, {context}"

    return name, short_name


def search_photon_locations(query: str) -> list:

    cache_key = query.casefold().strip()
    now = time.monotonic()

    cached = GEOCODING_CACHE.get(cache_key)

    if cached:
        created_at, cached_results = cached

        if now - created_at < GEOCODING_CACHE_TTL:
            return cached_results

    response = requests.get(
        PHOTON_URL,
        params={
            "q": query,
            "limit": 12,
            "lang": "en",
        },
        headers={
            "User-Agent": GEOCODING_USER_AGENT,
        },
        timeout=6,
    )

    response.raise_for_status()

    features = response.json().get("features", [])

    results = []
    seen = set()

    for feature in features:

        properties = feature.get("properties", {})
        geometry = feature.get("geometry", {})

        coordinates = geometry.get("coordinates", [])

        if len(coordinates) < 2:
            continue

        try:
            longitude = float(coordinates[0])
            latitude = float(coordinates[1])

        except (TypeError, ValueError):
            continue

        if not -90 <= latitude <= 90:
            continue

        if not -180 <= longitude <= 180:
            continue

        name, short_name = get_photon_display_name(properties)

        identity = (
            short_name.casefold(),
            round(latitude, 5),
            round(longitude, 5),
        )

        if identity in seen:
            continue

        seen.add(identity)

        results.append({
            "name": name,
            "short_name": short_name,
            "latitude": latitude,
            "longitude": longitude,
            "country": properties.get("country", ""),
            "state": properties.get("state", ""),
            "city": (
                properties.get("city")
                or properties.get("district")
                or ""
            ),
            "type": properties.get("type", "location"),
        })

    if len(GEOCODING_CACHE) >= GEOCODING_CACHE_LIMIT:
        GEOCODING_CACHE.clear()

    GEOCODING_CACHE[cache_key] = (now, results)

    return results


@app.get("/api/geocode")
def geocode_location():

    query = request.args.get("q", "").strip()

    if len(query) < 2:
        return jsonify({
            "success": True,
            "results": [],
        })

    if len(query) > 120:
        return jsonify({
            "success": False,
            "error": "Search text is too long.",
        }), 400

    try:

        results = search_photon_locations(query)

        return jsonify({
            "success": True,
            "count": len(results),
            "results": results,
        })

    except requests.Timeout:

        return jsonify({
            "success": False,
            "error": "Location search timed out. Please try again.",
        }), 504

    except requests.RequestException as exc:

        logger.warning("Photon location search failed: %s", exc)

        return jsonify({
            "success": False,
            "error": (
                "Global location search is temporarily unavailable. "
                "Please check your internet connection and try again."
            ),
        }), 503

    except (ValueError, KeyError, TypeError) as exc:

        logger.exception("Location response error: %s", exc)

        return jsonify({
            "success": False,
            "error": "Could not process location search results.",
        }), 502


# ---------------------------------------------------------------------
# Dataset retrieval
# ---------------------------------------------------------------------

def build_dataframe_from_stored_dataset(
    dataset_id: int,
) -> tuple[pd.DataFrame, dict]:

    result = get_stored_dataset(dataset_id)

    if not result:
        raise ValueError("Stored dataset could not be retrieved.")

    result = to_dict(result)

    metadata = to_dict(result.get("dataset"))
    observations = result.get("observations", [])

    if not observations:
        raise ValueError("Stored dataset contains no observations.")

    dataframe = pd.DataFrame([
        to_dict(item) for item in observations
    ])

    if not {"date", "value"}.issubset(dataframe.columns):
        raise ValueError(
            "Stored observations are missing date or value fields."
        )

    dataframe["date"] = pd.to_datetime(
        dataframe["date"],
        errors="coerce",
    )

    dataframe["value"] = pd.to_numeric(
        dataframe["value"],
        errors="coerce",
    )

    dataframe = dataframe.dropna(
        subset=["date", "value"]
    ).sort_values("date")

    if dataframe.empty:
        raise ValueError("No valid observations were found.")

    variable_id = (
        metadata.get("variable_id")
        or metadata.get("variable")
        or "temperature"
    )

    dataframe = (
        dataframe.set_index("date")[["value"]]
        .rename(columns={"value": variable_id})
    )

    return dataframe, metadata


def retrieve_dataset(payload: dict):

    variable_id = payload["variable_id"]
    live_error = None

    logger.info(
        "Starting NASA retrieval: %s | %s",
        variable_id,
        payload["region_name"],
    )

    # First priority: live NASA observations.
    try:

        live_result = fetch_and_store_dataset(
            variable_id=variable_id,
            latitude=payload["latitude"],
            longitude=payload["longitude"],
            start_date=payload["start_date"],
            end_date=payload["end_date"],
            region_name=payload["region_name"],
            frequency=payload["frequency"],
        )

        if (
            live_result
            and live_result.get("success")
            and live_result.get("dataset_id") is not None
        ):

            dataframe, stored_metadata = (
                build_dataframe_from_stored_dataset(
                    int(live_result["dataset_id"])
                )
            )

            dataframe = filter_requested_dates(
                dataframe,
                payload["start_date"],
                payload["end_date"],
            )

            if dataframe.empty:
                raise ValueError(
                    "NASA returned no observations in this date range."
                )

            metadata = {
                **stored_metadata,
                **live_result,
                "variable": variable_id,
                "variable_name": payload["variable_name"],
                "region": payload["region_name"],
                "latitude": payload["latitude"],
                "longitude": payload["longitude"],
                "frequency": payload["frequency"],
                "data_type": "live_nasa",
                "source_label": "Live NASA POWER Observations",
                "is_sample": False,
                "spatial_type": "point",
            }

            dataframe.attrs.update(metadata)

            logger.info(
                "NASA retrieval completed: %s observations",
                len(dataframe),
            )

            return dataframe, metadata, "live_nasa"

        live_error = (
            live_result or {}
        ).get(
            "message",
            "NASA did not return a usable dataset.",
        )

        logger.warning("NASA retrieval unavailable: %s", live_error)

    except Exception as exc:

        live_error = str(exc)

        logger.exception("NASA retrieval failed: %s", exc)

    # Second priority: previously cached NASA data or labelled demo data.
    try:

        start = date.fromisoformat(payload["start_date"])

        years = max(
            1,
            date.today().year - start.year + 1,
        )

        offline_result = get_offline_dataset(
            variable_id=variable_id,
            region_name=payload["region_name"],
            years=years,
            frequency=payload["frequency"],
            latitude=payload["latitude"],
            longitude=payload["longitude"],
        )

        if (
            not offline_result
            or not offline_result.get("success")
        ):
            raise ValueError(
                (offline_result or {}).get(
                    "message",
                    "Offline retrieval failed.",
                )
            )

        dataframe = offline_result["data"].copy()

        dataframe = filter_requested_dates(
            dataframe,
            payload["start_date"],
            payload["end_date"],
        )

        if dataframe.empty:
            raise ValueError(
                "No offline observations match the selected date range."
            )

        metadata = dict(
            offline_result.get("metadata") or {}
        )

        data_type = offline_result.get(
            "data_type",
            metadata.get("data_type", "sample_demo"),
        )

        if data_type == "cached_nasa":

            cached_region = str(
                metadata.get("region")
                or metadata.get("region_name")
                or ""
            ).strip().casefold()

            requested_region = (
                payload["region_name"].strip().casefold()
            )

            if (
                cached_region
                and cached_region != requested_region
            ):
                raise ValueError(
                    "Cached NASA data belongs to a different region."
                )

        metadata.update({
            "variable": variable_id,
            "variable_name": payload["variable_name"],
            "region": payload["region_name"],
            "latitude": payload["latitude"],
            "longitude": payload["longitude"],
            "frequency": payload["frequency"],
            "data_type": data_type,
            "source_label": offline_result.get(
                "source_label",
                metadata.get(
                    "source_label",
                    "Synthetic Demo Data",
                ),
            ),
            "live_nasa_error": live_error,
            "spatial_type": metadata.get("spatial_type", "point"),
        })

        dataframe.attrs.update(metadata)

        return dataframe, metadata, data_type

    except Exception as exc:

        logger.exception("Offline retrieval failed: %s", exc)

        raise RuntimeError(
            "NASA retrieval failed and no suitable offline "
            f"dataset was available: {exc}"
        ) from exc


# ---------------------------------------------------------------------
# Statistical analysis
# ---------------------------------------------------------------------

def run_statistical_analysis(
    dataframe: pd.DataFrame,
    variable_id: str,
    unit: str,
    frequency: str,
) -> dict:

    values = {
        "dataframe": dataframe,
        "df": dataframe,
        "series": dataframe[variable_id],
        "data": dataframe,
        "variable": variable_id,
        "variable_id": variable_id,
        "unit": unit,
        "frequency": frequency,
    }

    result = call_compatible(
        analyze_trend,
        values,
        {
            "time_series": "series",
            "observations": "dataframe",
        },
    )

    if not isinstance(result, dict) or result.get("success") is False:

        raise RuntimeError(
            (result or {}).get(
                "message",
                "Statistical analysis failed.",
            )
        )

    return json_safe(result)


# ---------------------------------------------------------------------
# Visualization
# ---------------------------------------------------------------------

def generate_visualization(
    dataframe: pd.DataFrame,
    variable_id: str,
    variable_name: str,
    region_name: str,
    unit: str,
    metadata: dict,
) -> str:

    chart = call_compatible(
        create_time_series_chart,
        {
            "dataframe": dataframe,
            "df": dataframe,
            "data": dataframe,
            "variable": variable_id,
            "variable_id": variable_id,
            "title": f"{variable_name} Trend - {region_name}",
            "unit": unit,
            "source_label": metadata.get("source_label"),
            "metadata": metadata,
        },
    )

    filename = (
        f"trendmatrix_chart_{safe_filename(variable_id)}_"
        f"{safe_filename(region_name)}_"
        f"{datetime.now():%Y%m%d_%H%M%S}.html"
    )

    output_path = CHARTS_DIR / filename

    call_compatible(
        save_chart_html,
        {
            "chart": chart,
            "figure": chart,
            "fig": chart,
            "output_path": output_path,
            "file_path": output_path,
            "filepath": output_path,
            "path": output_path,
        },
    )

    if not output_path.exists():
        raise RuntimeError(
            "Visualization module did not create the chart file."
        )

    return filename


# ---------------------------------------------------------------------
# Gemini AI with a bounded wait
# ---------------------------------------------------------------------

def generate_ai_explanation(
    analysis: dict,
    metadata: dict,
) -> dict:
    """
    Run Gemini in a daemon thread.

    If Gemini is slow or unavailable, the scientific analysis and report
    can still be returned without waiting indefinitely.
    """

    result_queue = queue.Queue(maxsize=1)

    def worker():

        try:
            result = explain_analysis(
                analysis=analysis,
                metadata=metadata,
            )

            if isinstance(result, dict):
                result_queue.put(json_safe(result))
            else:
                result_queue.put({
                    "success": True,
                    "explanation": str(result),
                })

        except Exception as exc:

            result_queue.put({
                "success": False,
                "error": str(exc),
                "explanation": (
                    "Gemini AI is temporarily unavailable. "
                    "Verified statistical results were calculated "
                    "independently using Python."
                ),
            })

    thread = threading.Thread(
        target=worker,
        daemon=True,
    )

    thread.start()
    thread.join(GEMINI_WAIT_SECONDS)

    if thread.is_alive():

        logger.warning(
            "Gemini exceeded the %s-second wait limit.",
            GEMINI_WAIT_SECONDS,
        )

        return {
            "success": False,
            "timeout": True,
            "explanation": (
                "Gemini did not respond within the waiting period. "
                "The statistical analysis is still valid and was "
                "calculated independently using Python."
            ),
        }

    try:
        return result_queue.get_nowait()

    except queue.Empty:

        return {
            "success": False,
            "explanation": (
                "Gemini explanation is unavailable. "
                "Python statistical results remain available."
            ),
        }


# ---------------------------------------------------------------------
# Scientific report
# ---------------------------------------------------------------------

def generate_scientific_report(
    analysis: dict,
    metadata: dict,
    dataframe: pd.DataFrame,
    ai_result: dict,
) -> dict:

    result = call_compatible(
        generate_report,
        {
            "analysis": analysis,
            "analysis_result": analysis,
            "statistical_results": analysis,
            "results": analysis,
            "metadata": metadata,
            "dataset_metadata": metadata,
            "dataframe": dataframe,
            "data": dataframe,
            "ai_explanation": ai_result,
            "ai_result": ai_result,
            "output_dir": REPORTS_DIR,
            "report_dir": REPORTS_DIR,
            "directory": REPORTS_DIR,
            "format": "html",
            "report_format": "html",
        },
    )

    if isinstance(result, dict):
        report = dict(result)

    elif isinstance(result, (str, Path)):

        path = Path(result)

        report = {
            "success": path.exists(),
            "file_path": str(path),
            "filename": path.name,
        }

    else:

        report = {
            "success": False,
            "message": "Unexpected report-generator response.",
        }

    raw_filename = (
        report.get("filename")
        or report.get("file_path")
    )

    if raw_filename:

        filename = Path(raw_filename).name

        report.update({
            "filename": filename,
            "url": f"/reports/{filename}",
        })

    return json_safe(report)


# ---------------------------------------------------------------------
# Complete analysis pipeline
# ---------------------------------------------------------------------

def run_analysis(payload: dict) -> dict:

    request_data, error = validate_request_data(payload)

    if error:
        raise ValueError(error)

    started_at = time.monotonic()

    logger.info(
        "Analysis started: %s | %s | %s",
        request_data["variable_id"],
        request_data["region_name"],
        request_data["frequency"],
    )

    # Stage 1: retrieve observations.
    dataframe, metadata, data_type = retrieve_dataset(
        request_data
    )

    if dataframe.empty:
        raise ValueError("The selected dataset contains no observations.")

    # Stage 2: apply the requested frequency.
    dataframe, metadata = prepare_requested_frequency(
        dataframe,
        request_data["variable_id"],
        request_data["frequency"],
        metadata,
    )

    variable_id = request_data["variable_id"]

    unit = str(
        metadata.get("unit")
        or metadata.get("units")
        or "unknown"
    )

    logger.info(
        "Prepared %s observations for statistical analysis.",
        len(dataframe),
    )

    # Stage 3: verified Python statistical calculations.
    analysis = run_statistical_analysis(
        dataframe,
        variable_id,
        unit,
        request_data["frequency"],
    )

    # Stage 4: chart generation.
    chart_filename = generate_visualization(
        dataframe,
        variable_id,
        request_data["variable_name"],
        request_data["region_name"],
        unit,
        metadata,
    )

    # Stage 5: bounded-wait AI explanation.
    ai_result = generate_ai_explanation(
        analysis,
        metadata,
    )

    # Stage 6: scientific report.
    report_result = generate_scientific_report(
        analysis,
        metadata,
        dataframe,
        ai_result,
    )

    elapsed = round(
        time.monotonic() - started_at,
        2,
    )

    logger.info(
        "Analysis completed in %s seconds.",
        elapsed,
    )

    return json_safe({
        "success": True,
        "variable": variable_id,
        "variable_name": request_data["variable_name"],
        "region": request_data["region_name"],
        "frequency": request_data["frequency"],
        "start_date": request_data["start_date"],
        "end_date": request_data["end_date"],
        "observation_count": int(len(dataframe)),
        "data_type": data_type,
        "source_label": metadata.get(
            "source_label",
            "Unknown data source",
        ),
        "unit": unit,
        "processing_seconds": elapsed,
        "metadata": metadata,
        "analysis": analysis,
        "ai_explanation": ai_result,
        "chart": {
            "filename": chart_filename,
            "url": f"/charts/{chart_filename}",
        },
        "report": report_result,
    })


# ---------------------------------------------------------------------
# Dashboard HTML
# ---------------------------------------------------------------------

DASHBOARD_HTML = r"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TrendMatrix AI | Earth Systems Trend Detective</title>

<style>
:root{
 --bg:#0b1220;
 --panel:#131f32;
 --panel2:#0d192b;
 --border:#293c56;
 --text:#eaf1fa;
 --muted:#a9bad0;
 --accent:#55c5b2;
 --warning:#ffd18a;
 --danger:#ff8585;
 --green:#78d6a6;
}

*{box-sizing:border-box}

body{
 margin:0;
 padding:28px 18px 60px;
 background:var(--bg);
 color:var(--text);
 font-family:Inter,Arial,sans-serif;
 line-height:1.55;
}

.container{max-width:1180px;margin:auto}
header{margin-bottom:26px}
h1{color:var(--accent);margin:0 0 5px;font-size:30px}
h2{font-size:20px;margin:0 0 12px}
h3{font-size:16px;margin:0 0 12px}

.muted,.subtitle{color:var(--muted)}

.panel{
 background:var(--panel);
 border:1px solid var(--border);
 border-radius:12px;
 padding:22px;
 margin-bottom:20px;
 min-width:0;
}

.form-grid{
 display:grid;
 grid-template-columns:repeat(2,minmax(0,1fr));
 gap:16px;
}

.field{min-width:0;position:relative}

label{
 display:block;
 color:var(--muted);
 font-size:13px;
 margin:0 0 6px;
}

input,select{
 width:100%;
 min-height:42px;
 padding:10px 12px;
 border:1px solid var(--border);
 border-radius:7px;
 background:#0b1627;
 color:var(--text);
 outline:none;
}

input:focus,select:focus{border-color:var(--accent)}

button{
 border:0;
 border-radius:7px;
 background:var(--accent);
 color:#062321;
 font-weight:700;
 padding:12px 20px;
 cursor:pointer;
}

button:disabled{opacity:.55;cursor:wait}

.suggestions{
 display:none;
 position:absolute;
 z-index:20;
 top:70px;
 left:0;
 right:0;
 max-height:330px;
 overflow-y:auto;
 background:#101d30;
 border:1px solid var(--border);
 border-radius:8px;
 box-shadow:0 12px 30px #0008;
}

.suggestion{
 padding:11px 13px;
 border-bottom:1px solid var(--border);
 cursor:pointer;
 font-size:13px;
}

.suggestion:hover,.suggestion.active{background:#1c3048}

.suggestion small{
 display:block;
 color:var(--muted);
}

.hint{
 font-size:12px;
 color:var(--muted);
 margin-top:6px;
}

.status{
 margin-top:14px;
 color:var(--muted);
 white-space:pre-wrap;
}

.error{color:var(--danger)}
.warning{color:var(--warning)}
.success{color:var(--green)}

.result{display:none}

.source{
 display:inline-block;
 padding:6px 11px;
 border-radius:20px;
 background:#173f45;
 color:var(--accent);
 font-size:12px;
 font-weight:700;
}

.info-grid{
 display:grid;
 grid-template-columns:repeat(4,minmax(0,1fr));
 gap:12px;
 margin-top:16px;
}

.info-card,.metric{
 background:var(--panel2);
 border:1px solid var(--border);
 border-radius:9px;
 padding:13px;
 min-width:0;
}

.info-card span,.metric .label{
 display:block;
 color:var(--muted);
 font-size:12px;
}

.info-card strong,.metric .value{
 display:block;
 font-size:15px;
 margin-top:4px;
 overflow-wrap:anywhere;
}

.warning-box{
 margin-top:14px;
 padding:11px 13px;
 border-left:3px solid var(--warning);
 background:#30291d;
 color:var(--warning);
 border-radius:5px;
 font-size:13px;
}

.chart-frame{
 width:100%;
 height:570px;
 border:1px solid var(--border);
 border-radius:8px;
 background:#fff;
}

.metrics{
 display:grid;
 grid-template-columns:repeat(3,minmax(0,1fr));
 gap:12px;
 margin:14px 0;
}

.metric .value{
 font-size:20px;
 font-weight:700;
 color:var(--accent);
}

.metric .sub{
 font-size:11px;
 color:var(--muted);
 margin-top:4px;
}

.table-wrap{overflow-x:auto}

table{
 width:100%;
 border-collapse:collapse;
 font-size:13px;
}

th,td{
 text-align:left;
 padding:10px 12px;
 border-bottom:1px solid var(--border);
}

th{
 color:var(--muted);
 font-weight:600;
 background:#101b2c;
}

td:last-child{overflow-wrap:anywhere}

.ai-text{
 white-space:pre-wrap;
 overflow-wrap:anywhere;
 background:var(--panel2);
 padding:16px;
 border-radius:8px;
 font-size:14px;
}

.link{
 color:var(--accent);
 font-weight:600;
}

.spinner{
 display:inline-block;
 width:14px;
 height:14px;
 border:2px solid #174c48;
 border-top-color:#062321;
 border-radius:50%;
 animation:spin .8s linear infinite;
 vertical-align:-2px;
 margin-right:8px;
}

@keyframes spin{
 to{transform:rotate(360deg)}
}

.section-note{
 font-size:12px;
 color:var(--muted);
 margin-top:8px;
}

@media(max-width:800px){
 .info-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
 .metrics{grid-template-columns:repeat(2,minmax(0,1fr))}
 .chart-frame{height:480px}
}

@media(max-width:560px){
 body{padding:18px 10px 40px}
 .panel{padding:16px}
 .form-grid{grid-template-columns:1fr}
 .info-grid,.metrics{grid-template-columns:1fr 1fr}
 h1{font-size:25px}
 .chart-frame{height:420px}
}
</style>
</head>

<body>
<main class="container">

<header>
<h1>TrendMatrix AI</h1>
<div class="subtitle">
Be an Earth Systems Trend Detective. Explore NASA observations,
identify long-term trends, and generate scientific reports.
</div>
</header>

<section class="panel">
<h2>Dataset Selection</h2>

<p class="muted">
Choose an Earth science variable and search globally for a
country, city, or region. Coordinates are detected automatically.
Live NASA observations are requested first.
</p>

<form id="analysisForm">

<div class="form-grid">

<div class="field">
<label for="variable">Earth Science Variable</label>

<select id="variable" name="variable" required>
<option value="temperature">Air Temperature</option>
<option value="humidity">Relative Humidity</option>
<option value="wind_speed">Wind Speed</option>
<option value="precipitation">Precipitation</option>
<option value="soil_moisture">Soil Moisture</option>
<option value="evapotranspiration">Evapotranspiration</option>
<option value="ndvi">Normalized Difference Vegetation Index (NDVI)</option>
<option value="solar_radiation">Solar Radiation</option>
</select>
</div>

<div class="field">
<label for="locationSearch">Country, City, or Region</label>

<input
 id="locationSearch"
 autocomplete="off"
 placeholder="Start typing: Pakistan, Lahore, London..."
 required
>

<div id="suggestions" class="suggestions"></div>

<div id="locationHint" class="hint">
Type at least two letters. Worldwide suggestions will appear automatically.
</div>

<input type="hidden" id="region" name="region">
<input type="hidden" id="latitude" name="latitude">
<input type="hidden" id="longitude" name="longitude">

</div>

<div class="field">
<label for="start_date">Start Date</label>
<input
 id="start_date"
 name="start_date"
 type="date"
 value="2016-01-01"
 required
>
</div>

<div class="field">
<label for="end_date">End Date</label>
<input
 id="end_date"
 name="end_date"
 type="date"
 value="2025-12-31"
 required
>
</div>

<div class="field">
<label for="frequency">Data Frequency</label>

<select id="frequency" name="frequency">
<option value="monthly" selected>Monthly</option>
<option value="daily">Daily</option>
</select>
</div>

</div>

<button id="analyzeButton" type="submit">
Analyze Earth Science Trends
</button>

<div id="status" class="status" role="status" aria-live="polite"></div>

</form>
</section>


<section id="resultSection" class="result">

<div class="panel">
<h2>Dataset Information</h2>
<span id="sourceLabel" class="source"></span>
<div id="datasetInfo" class="info-grid"></div>
<div id="dataWarning"></div>
</div>

<div class="panel">
<h2>Time-Series Visualization</h2>
<iframe
 id="chartFrame"
 class="chart-frame"
 title="Interactive time-series chart"
 loading="lazy"
></iframe>
<div class="section-note">
Use the Plotly toolbar to zoom, pan, and download the chart.
</div>
</div>

<div class="panel">
<h2>Statistical Analysis</h2>
<div id="keyMetrics" class="metrics"></div>

<h3>Detailed Statistical Results</h3>

<div class="table-wrap">
<table>
<thead>
<tr>
<th>Measure</th>
<th>Result</th>
<th>Interpretation</th>
</tr>
</thead>
<tbody id="statisticsTable"></tbody>
</table>
</div>

<div id="scientificCaution" class="warning-box"></div>
</div>

<div class="panel">
<h2>Gemini AI Explanation</h2>
<div id="aiStatus" class="section-note"></div>
<div id="aiOutput" class="ai-text"></div>
</div>

<div class="panel">
<h2>Scientific Report</h2>
<p id="reportStatus" class="muted"></p>
<a
 id="reportLink"
 class="link"
 target="_blank"
 rel="noopener"
 style="display:none"
>
Open Scientific Report ↗
</a>
</div>

</section>
</main>


<script>

const form = document.getElementById('analysisForm');
const button = document.getElementById('analyzeButton');
const statusBox = document.getElementById('status');

const searchInput = document.getElementById('locationSearch');
const suggestions = document.getElementById('suggestions');

let selectedLocation = null;
let geocodeTimer = null;
let geocodeController = null;
let analysisController = null;
let activeSuggestionIndex = -1;
let currentSuggestions = [];


function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, character => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
    }[character]));
}


function clearSelectedLocation() {

    selectedLocation = null;

    document.getElementById('region').value = '';
    document.getElementById('latitude').value = '';
    document.getElementById('longitude').value = '';

    document.getElementById('locationHint').textContent =
        'Select a location from the suggestions. Coordinates are detected automatically.';
}


function hideSuggestions() {

    suggestions.style.display = 'none';
    activeSuggestionIndex = -1;
}


function showMessage(message) {

    suggestions.innerHTML =
        `<div class="suggestion">${escapeHtml(message)}</div>`;

    suggestions.style.display = 'block';
}


function selectLocation(place) {

    selectedLocation = place;

    searchInput.value = place.short_name;

    document.getElementById('region').value =
        place.short_name;

    document.getElementById('latitude').value =
        place.latitude;

    document.getElementById('longitude').value =
        place.longitude;

    document.getElementById('locationHint').textContent =
        `Selected: ${place.short_name}. Coordinates detected automatically.`;

    hideSuggestions();
}


function renderLocationSuggestions(results) {

    currentSuggestions = results;
    activeSuggestionIndex = -1;

    if (!results.length) {
        showMessage('No matching locations found. Try another spelling.');
        return;
    }

    suggestions.innerHTML = results.map((place, index) => {

        const details = [
            place.city,
            place.state,
            place.country
        ].filter(Boolean).join(', ');

        return `
            <div class="suggestion" data-index="${index}">
                <strong>${escapeHtml(place.name)}</strong>
                <small>${escapeHtml(details || place.short_name)}</small>
            </div>
        `;

    }).join('');

    suggestions.querySelectorAll('.suggestion[data-index]')
        .forEach(element => {

            element.addEventListener('click', () => {

                const index = Number(element.dataset.index);

                selectLocation(currentSuggestions[index]);

            });

        });

    suggestions.style.display = 'block';
}


async function searchLocations(query) {

    if (query.length < 2) {
        hideSuggestions();
        return;
    }

    if (geocodeController) {
        geocodeController.abort();
    }

    geocodeController = new AbortController();

    const controller = geocodeController;

    showMessage('Searching worldwide locations...');

    try {

        const response = await fetch(
            '/api/geocode?q=' + encodeURIComponent(query),
            { signal: controller.signal }
        );

        const data = await response.json();

        if (controller !== geocodeController) {
            return;
        }

        if (!response.ok) {
            throw new Error(
                data.error || 'Location search failed.'
            );
        }

        renderLocationSuggestions(data.results || []);

    } catch (error) {

        if (error.name === 'AbortError') {
            return;
        }

        showMessage(error.message);
    }
}


// Search automatically while the user types.
searchInput.addEventListener('input', () => {

    clearSelectedLocation();

    clearTimeout(geocodeTimer);

    if (geocodeController) {
        geocodeController.abort();
    }

    const query = searchInput.value.trim();

    if (query.length < 2) {
        hideSuggestions();
        return;
    }

    // Debounce requests to reduce unnecessary API traffic.
    geocodeTimer = setTimeout(() => {
        searchLocations(query);
    }, 350);

});


// Keyboard navigation inside the suggestion list.
searchInput.addEventListener('keydown', event => {

    const items = suggestions.querySelectorAll(
        '.suggestion[data-index]'
    );

    if (event.key === 'ArrowDown' && items.length) {

        event.preventDefault();

        activeSuggestionIndex = Math.min(
            activeSuggestionIndex + 1,
            items.length - 1
        );

    } else if (event.key === 'ArrowUp' && items.length) {

        event.preventDefault();

        activeSuggestionIndex = Math.max(
            activeSuggestionIndex - 1,
            0
        );

    } else if (event.key === 'Enter' && items.length) {

        event.preventDefault();

        if (activeSuggestionIndex >= 0) {
            selectLocation(
                currentSuggestions[activeSuggestionIndex]
            );
        }

        return;

    } else if (event.key === 'Escape') {

        hideSuggestions();
        return;
    }

    items.forEach((item, index) => {

        item.classList.toggle(
            'active',
            index === activeSuggestionIndex
        );

    });

});


document.addEventListener('click', event => {

    if (!event.target.closest('#locationSearch') &&
        !event.target.closest('#suggestions')) {

        hideSuggestions();
    }

});


function getNested(object, path) {

    return path.split('.').reduce(
        (value, key) =>
            value && value[key] !== undefined
                ? value[key]
                : undefined,
        object
    );
}


function firstValue(object, paths) {

    for (const path of paths) {

        const value = getNested(object, path);

        if (value !== undefined && value !== null) {
            return value;
        }

    }

    return null;
}


function fmt(value, digits = 4) {

    if (
        value === null ||
        value === undefined ||
        value === '' ||
        typeof value === 'object'
    ) {
        return 'Not available';
    }

    const number = Number(value);

    return Number.isFinite(number)
        ? number.toFixed(digits)
        : String(value);
}


function pFmt(value) {

    if (value === null || value === undefined) {
        return 'Not available';
    }

    const number = Number(value);

    return Number.isFinite(number)
        ? (
            number < 0.0001
                ? number.toExponential(2)
                : number.toFixed(5)
        )
        : String(value);
}


function metric(label, value, sub = '') {

    return `
        <div class="metric">
            <span class="label">${escapeHtml(label)}</span>
            <span class="value">${escapeHtml(value)}</span>
            <div class="sub">${escapeHtml(sub)}</div>
        </div>
    `;
}


function addRow(label, value, interpretation = '—') {

    return `
        <tr>
            <td>${escapeHtml(label)}</td>
            <td>${escapeHtml(value)}</td>
            <td>${escapeHtml(interpretation)}</td>
        </tr>
    `;
}


function renderStatistics(analysis, unit) {

    const direction = firstValue(analysis, [
        'interpretation.direction',
        'direction',
        'mann_kendall.trend',
        'mann_kendall.trend_direction'
    ]) ?? 'Not available';

    const slope = firstValue(analysis, [
        'linear_regression.slope_per_year',
        'linear_regression.slope',
        'slope_per_year'
    ]);

    const hac = firstValue(analysis, [
        'linear_regression.hac_p_value',
        'hac_p_value'
    ]);

    const ordinary = firstValue(analysis, [
        'linear_regression.p_value',
        'p_value'
    ]);

    const mkp = firstValue(analysis, [
        'mann_kendall.p_value',
        'mann_kendall.p'
    ]);

    const r2 = firstValue(analysis, [
        'linear_regression.r_squared',
        'linear_regression.r2',
        'r_squared'
    ]);

    const ci = firstValue(analysis, [
        'linear_regression.confidence_interval',
        'confidence_interval'
    ]);

    const hacci = firstValue(analysis, [
        'linear_regression.hac_confidence_interval'
    ]);

    const autocorr = firstValue(analysis, [
        'autocorrelation.lag_1_correlation',
        'autocorrelation.lag1_correlation'
    ]);

    const seasonal = firstValue(analysis, [
        'seasonal_mann_kendall.trend',
        'seasonal_mann_kendall.trend_direction'
    ]);

    const seasonalP = firstValue(analysis, [
        'seasonal_mann_kendall.p_value'
    ]);

    const slopeText = slope === null
        ? 'Not available'
        : `${fmt(slope, 5)} ${unit}/year`;

    document.getElementById('keyMetrics').innerHTML =

        metric('Trend Direction', String(direction)) +

        metric(
            'Annual Rate of Change',
            slopeText,
            'Linear regression slope'
        ) +

        metric(
            'Mann-Kendall p-value',
            pFmt(mkp),
            'Non-parametric trend test'
        ) +

        metric(
            'HAC-adjusted p-value',
            pFmt(hac),
            'Accounts for autocorrelation'
        ) +

        metric(
            'R-squared',
            fmt(r2, 4),
            'Linear model fit'
        ) +

        metric(
            'Observations',
            String(
                analysis.observation_count ?? 'Not available'
            )
        );


    let significance = 'Not available';

    if (hac !== null) {

        significance = Number(hac) < 0.05
            ? 'Significant at 5% (HAC-adjusted)'
            : 'Not statistically significant at 5% (HAC-adjusted)';
    }


    const ciText = Array.isArray(ci)
        ? ci.map(value => fmt(value, 5)).join(' to ')
        : 'Not available';

    const hacCiText = Array.isArray(hacci)
        ? hacci.map(value => fmt(value, 5)).join(' to ')
        : 'Not available';


    let rows = '';

    rows += addRow('Trend direction', direction);

    rows += addRow(
        'Linear slope per year',
        slopeText
    );

    rows += addRow(
        'Ordinary regression p-value',
        pFmt(ordinary)
    );

    rows += addRow(
        'HAC-adjusted p-value',
        pFmt(hac),
        significance
    );

    rows += addRow(
        'R-squared',
        fmt(r2, 5)
    );

    rows += addRow(
        'Linear confidence interval',
        ciText
    );

    // Correct variable name: hacCiText.
    rows += addRow(
        'HAC confidence interval',
        hacCiText
    );

    rows += addRow(
        'Mann-Kendall trend',
        String(
            firstValue(analysis, [
                'mann_kendall.trend',
                'mann_kendall.trend_direction'
            ]) ?? 'Not available'
        )
    );

    rows += addRow(
        'Mann-Kendall p-value',
        pFmt(mkp)
    );

    rows += addRow(
        'Seasonal Mann-Kendall trend',
        String(seasonal ?? 'Not available')
    );

    rows += addRow(
        'Seasonal Mann-Kendall p-value',
        pFmt(seasonalP)
    );

    rows += addRow(
        'Lag-1 residual autocorrelation',
        fmt(autocorr, 4)
    );

    document.getElementById('statisticsTable').innerHTML = rows;


    const cautions = [];

    if (
        autocorr !== null &&
        Math.abs(Number(autocorr)) >= 0.5
    ) {

        cautions.push(
            'Strong lag-1 residual autocorrelation was detected. ' +
            'Prefer HAC-adjusted inference and interpret ordinary ' +
            'regression p-values cautiously.'
        );
    }

    if (
        hac !== null &&
        ordinary !== null &&
        (
            (Number(hac) < 0.05) !==
            (Number(ordinary) < 0.05)
        )
    ) {

        cautions.push(
            'Ordinary and HAC-adjusted regression significance differ. ' +
            'The autocorrelation-adjusted result should be highlighted.'
        );
    }

    cautions.push(
        'A trend association does not establish causation. ' +
        'Statistical significance and trend magnitude are different concepts.'
    );

    document.getElementById(
        'scientificCaution'
    ).textContent = cautions.join(' ');
}


function renderAi(ai) {

    const explanation =
        ai.explanation ||
        ai.message ||
        'AI explanation is currently unavailable.';

    document.getElementById('aiOutput').textContent =
        explanation;

    document.getElementById('aiStatus').textContent =
        ai.success
            ? 'Gemini explanation received. Statistical values above remain calculated by Python.'
            : 'Gemini is temporarily unavailable or timed out. Scientific analysis remains independently available.';
}


// ------------------------------------------------------------------
// Main analysis submission
// ------------------------------------------------------------------

form.addEventListener('submit', async event => {

    event.preventDefault();

    if (!selectedLocation) {

        statusBox.textContent =
            'Please search for a location and select one of the suggestions.';

        statusBox.className = 'status error';

        searchInput.focus();

        return;
    }

    if (analysisController) {
        analysisController.abort();
    }

    analysisController = new AbortController();

    const timeout = setTimeout(
        () => analysisController.abort(),
        120000
    );

    button.disabled = true;

    button.innerHTML =
        '<span class="spinner"></span>Processing…';

    statusBox.className = 'status';

    statusBox.textContent =
        'Step 1/4: Requesting NASA observations...';

    document.getElementById('resultSection').style.display =
        'none';


    try {

        const payload = Object.fromEntries(
            new FormData(form).entries()
        );

        const response = await fetch(
            '/api/analyze',
            {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload),
                signal: analysisController.signal
            }
        );

        const result = await response.json();

        if (!response.ok || !result.success) {

            throw new Error(
                result.error || 'Analysis could not be completed.'
            );
        }


        // Dataset information.
        document.getElementById('sourceLabel').textContent =
            result.source_label;

        const info = [
            ['Variable', result.variable_name],
            ['Location', result.region],
            ['Observations', result.observation_count],
            ['Frequency', result.frequency],
            ['Unit', result.unit],
            [
                'Date range',
                result.start_date + ' to ' + result.end_date
            ],
            ['Data classification', result.data_type],
            ['Processing time', result.processing_seconds + ' seconds'],
            ['Spatial representation', 'Point observation']
        ];

        document.getElementById('datasetInfo').innerHTML =
            info.map(([key, value]) => `
                <div class="info-card">
                    <span>${escapeHtml(key)}</span>
                    <strong>${escapeHtml(value)}</strong>
                </div>
            `).join('');


        // Scientific source disclosure.
        const warning = document.getElementById('dataWarning');

        if (result.data_type === 'sample_demo') {

            warning.className = 'warning-box';

            warning.textContent =
                'DEMO DATA: These are synthetic observations, not NASA measurements. Do not use them as scientific evidence.';

        } else if (result.data_type === 'cached_nasa') {

            warning.className = 'warning-box';

            warning.textContent =
                'Cached NASA observations are being used. These are real NASA measurements retrieved previously.';

        } else {

            warning.className = 'warning-box';

            warning.textContent =
                'Live NASA observations were successfully retrieved. This is a point-based observation, not a country-wide or regional spatial average.';
        }


        // Chart.
        document.getElementById('chartFrame').src =
            result.chart.url + '?v=' + Date.now();


        // Statistics.
        renderStatistics(
            result.analysis || {},
            result.unit || ''
        );


        // Gemini.
        renderAi(
            result.ai_explanation || {}
        );


        // Report.
        const report = result.report || {};

        document.getElementById('reportStatus').textContent =
            report.success
                ? 'Scientific HTML report generated successfully.'
                : (
                    report.message ||
                    'Report generation needs attention.'
                );

        const link = document.getElementById('reportLink');

        if (report.url) {

            link.href = report.url;
            link.style.display = 'inline-block';

        } else {

            link.removeAttribute('href');
            link.style.display = 'none';
        }


        document.getElementById('resultSection').style.display =
            'block';

        statusBox.className = 'status success';

        statusBox.textContent =
            `Analysis completed successfully in ${result.processing_seconds} seconds.`;

    } catch (error) {

        statusBox.className = 'status error';

        statusBox.textContent =
            error.name === 'AbortError'
                ? 'The request timed out after 2 minutes. Try a shorter date range or try again later.'
                : 'Error: ' + error.message;

    } finally {

        clearTimeout(timeout);

        button.disabled = false;

        button.textContent =
            'Analyze Earth Science Trends';

        analysisController = null;
    }

});

</script>
</body>
</html>
"""


# ---------------------------------------------------------------------
# Flask routes
# ---------------------------------------------------------------------

@app.get("/")
def dashboard():

    return render_template_string(DASHBOARD_HTML)


@app.get("/health")
def health():

    return jsonify({
        "success": True,
        "application": "TrendMatrix AI",
        "status": "running",
    })


@app.get("/api/datasets")
def list_datasets():

    try:

        datasets = get_available_datasets()

        return jsonify({
            "success": True,
            "count": len(datasets),
            "datasets": [
                to_dict(item) for item in datasets
            ],
        })

    except Exception as exc:

        logger.exception(
            "Dataset listing failed: %s",
            exc,
        )

        return jsonify({
            "success": False,
            "error": str(exc),
        }), 500


@app.post("/api/analyze")
def analyze():

    payload = request.get_json(silent=True)

    if not isinstance(payload, dict):

        return jsonify({
            "success": False,
            "error": "A valid JSON request body is required.",
        }), 400

    try:

        return jsonify(run_analysis(payload))

    except ValueError as exc:

        return jsonify({
            "success": False,
            "error": str(exc),
        }), 400

    except Exception as exc:

        logger.exception(
            "TrendMatrix analysis failed: %s",
            exc,
        )

        return jsonify({
            "success": False,
            "error": str(exc),
        }), 500


@app.get("/charts/<path:filename>")
def open_chart_file(filename: str):

    return send_from_directory(
        CHARTS_DIR,
        filename,
    )


@app.get("/reports/<path:filename>")
def open_report_file(filename: str):

    return send_from_directory(
        REPORTS_DIR,
        filename,
    )


@app.errorhandler(404)
def not_found(_error):

    return jsonify({
        "success": False,
        "error": "The requested resource was not found.",
    }), 404


@app.errorhandler(500)
def internal_error(_error):

    return jsonify({
        "success": False,
        "error": (
            "An internal server error occurred. "
            "Check the application terminal for details."
        ),
    }), 500


# ---------------------------------------------------------------------
# Application entry point
# ---------------------------------------------------------------------

if __name__ == "__main__":

    app.run(
        host="127.0.0.1",
        port=5000,
        debug=bool(getattr(Config, "DEBUG", False)),
        threaded=True,
    )